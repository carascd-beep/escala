# Configurações da Aplicação
APP_NAME="Escala Paróquia São João Bosco"
APP_ENV=development
DEBUG=true
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Banco de Dados
DATABASE_URL=sqlite:///./data/escala.db
# Para Supabase, substitua pela Connection string (URI) do banco PostgreSQL.
# DATABASE_URL=postgresql://postgres:SENHA@db.PROJETO.supabase.co:5432/postgres?sslmode=require

# Admin Inicial
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@paroquia.com

# Servidor
HOST=0.0.0.0
PORT=8000
